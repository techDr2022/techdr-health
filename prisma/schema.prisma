generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  DOCTOR
  PATIENT
  ADMIN
}

enum PlanType {
  INDIVIDUAL
  CLINIC
  HOSPITAL
}

enum SubStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RoomStatus {
  WAITING
  ACTIVE
  ENDED
  MISSED
}

enum ConsultType {
  VIDEO
  AUDIO
  CHAT
}

enum PayStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum WeekDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum ReferralStatus {
  PENDING
  JOINED
  REWARDED
}

enum Payoutrecordstatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum Bookingqueuestatus {
  WAITING
  MATCHED
  EXPIRED
  CANCELLED
}

enum Healthrecordtype {
  LAB_REPORT
  PRESCRIPTION
  SCAN
  OTHER
}

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  phone             String?         @unique
  passwordHash      String
  role              Role            @default(PATIENT)
  name              String
  avatarUrl         String?
  isVerified        Boolean         @default(false)
  phoneVerified     Boolean         @default(false)
  emailVerified     Boolean         @default(false)
  authProvider      String          @default("email")
  lastLoginAt       DateTime?
  loginCount        Int             @default(0)
  isActive          Boolean         @default(true)
  marketingconsent      Boolean       @default(false)
  marketingconsentat    DateTime?
  datadeleterequested   Boolean       @default(false)
  datadeleterequestedat DateTime?
  preferredlang         String        @default("en")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  doctorProfile     DoctorProfile?
  bookingsAsPatient Booking[]       @relation("PatientBookings")
  patientsubscription Patientsubscription?
  healthNudges      HealthNudge[]
  sessions          Session[]
  authSessions      AuthSession[]
  blogPosts         BlogPost[]
  bookingqueues     Bookingqueue[]
  healthrecords     Healthrecord[]
  familymembers     Familymember[]
  devicetokens      Devicetoken[]
  aicalllogs        Aicalllog[]
  labtestorders     Labtestorder[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpRecord {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  purpose   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

model AuthSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  device       String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
}

model DoctorProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug            String         @unique
  displayName     String
  photoUrl        String?
  coverPhotoUrl   String?

  specialty       String
  subSpecialties  String[]
  credentials     String
  medRegNumber    String
  experience      Int
  education       Json
  hospitalAffils  String[]
  bio             String?        @db.Text
  languages       String[]
  conditions      String[]
  awards          Json?

  consultFee      Int
  followUpFee     Int            @default(0)
  consultDuration Int            @default(20)
  consultTypes    ConsultType[]

  approvalStatus  ApprovalStatus @default(PENDING)
  isVisible       Boolean        @default(false)
  rejectionReason String?

  medRegCertUrl   String?
  degreeDocUrl    String?
  govIdUrl        String?

  nmcverified     Boolean        @default(false)
  nmcverifiedat   DateTime?
  nmcverifiedby   String?

  referralcode    String?        @unique
  patientreferralcode String?    @unique

  subscription    Subscription?
  timings         DoctorTiming[]
  bookings        Booking[]      @relation("DoctorBookings")
  reviews         Review[]
  referralsMade   DoctorReferral[] @relation("ReferrerDoctor")
  referredBy      DoctorReferral?  @relation("ReferredDoctor")
  bankaccount     Doctorbankaccount?
  payoutrecords   Payoutrecord[]
  bookingqueues   Bookingqueue[]
  referralmilestones Referralmilestone[]

  acceptinstantconsult Boolean       @default(false)
  instantonline        Boolean       @default(false)
  surgepricingenabled  Boolean       @default(true)

  metaTitle       String?
  metaDesc        String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model DoctorReferral {
  id                 String         @id @default(cuid())
  referrerdoctorid   String
  referrer           DoctorProfile  @relation("ReferrerDoctor", fields: [referrerdoctorid], references: [id])
  referreddoctorid   String         @unique
  referred           DoctorProfile  @relation("ReferredDoctor", fields: [referreddoctorid], references: [id])
  status             ReferralStatus @default(PENDING)
  joinedat           DateTime?
  rewardgrantedat    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([referrerdoctorid])
}

model Referralmilestone {
  id          String        @id @default(cuid())
  doctorid    String
  doctor      DoctorProfile @relation(fields: [doctorid], references: [id], onDelete: Cascade)
  milestone   Int
  rewardtype  String
  rewardvalue String
  awardedat   DateTime      @default(now())
  paid        Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([doctorid, milestone])
  @@index([doctorid])
  @@index([paid, rewardtype])
}

model Doctorbankaccount {
  id                    String        @id @default(cuid())
  doctorid              String        @unique
  doctor                DoctorProfile @relation(fields: [doctorid], references: [id], onDelete: Cascade)
  accountname           String
  accountnumber         String
  ifsc                  String
  verified              Boolean       @default(false)
  cashfreebeneficiaryid String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Payoutrecord {
  id                 String             @id @default(cuid())
  doctorid           String
  doctor             DoctorProfile      @relation(fields: [doctorid], references: [id], onDelete: Cascade)
  amountinr          Int
  tdsinr             Int                @default(0)
  bookingcount       Int
  bookingids         String[]
  cashfreetransferid String?
  reference          String             @unique
  status             Payoutrecordstatus @default(PENDING)
  errormessage       String?
  processedat        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([doctorid, createdAt])
  @@index([status])
}

model Patientsubscription {
  id              String    @id @default(cuid())
  userid          String    @unique
  user            User      @relation(fields: [userid], references: [id], onDelete: Cascade)
  plan            String
  status          String    @default("PENDING_PAYMENT")
  startdate       DateTime?
  enddate         DateTime?
  cashfreeorderid String?   @unique
  videoconsultsused Int     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DoctorTiming {
  id       String        @id @default(cuid())
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  day      WeekDay
  isOpen   Boolean       @default(true)
  slots    TimeSlot[]

  @@unique([doctorId, day])
}

model TimeSlot {
  id        String       @id @default(cuid())
  timingId  String
  timing    DoctorTiming @relation(fields: [timingId], references: [id], onDelete: Cascade)
  startTime String
  endTime   String
  isBooked  Boolean      @default(false)
}

model Subscription {
  id                  String        @id @default(cuid())
  doctorId            String        @unique
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id])

  plan                PlanType
  status              SubStatus     @default(PENDING_PAYMENT)
  priceINR            Int

  purchasedAt         DateTime?
  activatedAt         DateTime?
  expiresAt           DateTime?
  cancelledAt         DateTime?

  cashfreeOrderId     String?       @unique
  cashfreePaymentId   String?
  cashfreeSignature   String?

  renewalReminderSent Boolean       @default(false)
  expiredEmailSent    Boolean       @default(false)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Booking {
  id                 String        @id @default(cuid())
  patientId          String
  patient            User          @relation("PatientBookings", fields: [patientId], references: [id])
  doctorId           String
  doctor             DoctorProfile @relation("DoctorBookings", fields: [doctorId], references: [id])

  scheduledAt        DateTime
  endsAt             DateTime
  consultType        ConsultType
  status             BookingStatus @default(UPCOMING)

  consultFee         Int
  platformFeeINR     Int
  doctorPayoutINR    Int
  gstINR             Int
  totalPatientPays   Int

  payStatus          PayStatus     @default(PENDING)
  cashfreeOrderId    String?
  cashfreePaymentId  String?

  payoutStatus       PayoutStatus  @default(PENDING)
  payoutDate         DateTime?
  payoutRef          String?

  meetingLink        String?
  notes              String?       @db.Text
  prescription       Json?
  diagnosis          String?
  labReportAnalysis  Json?

  followUpDate       DateTime?

  cancellationReason String?
  cancelledBy        String?

  consentgiven       Boolean       @default(false)
  consenttimestamp   DateTime?
  consentip          String?

  isfirstconsult     Boolean       @default(true)

  healthpassapplied    Boolean       @default(false)
  healthpassdiscountinr Int          @default(0)

  isinstantconsult     Boolean       @default(false)
  reminderpushsent     Boolean       @default(false)

  invoicenumber        String?
  invoicepdfkey        String?
  invoiceissuedat      DateTime?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  review             Review?
  earnings           PlatformEarning?
  consultationRoom   ConsultationRoom?
  prescriptionRecord Prescription?
  soapnote           Soapnote?
  familymemberid     String?
  familymember       Familymember? @relation(fields: [familymemberid], references: [id], onDelete: SetNull)
  bookingqueue       Bookingqueue?

  secondopinionforbookingid   String?
  originalbooking             Booking?  @relation("SecondOpinion", fields: [secondopinionforbookingid], references: [id], onDelete: SetNull)
  secondopinionbookings       Booking[] @relation("SecondOpinion")
  issecondopinion             Boolean   @default(false)
  secondopinionshareconsent   Boolean   @default(false)

  surgemultiplier             Float?
}

model Bookingqueue {
  id            String             @id @default(cuid())
  patientid     String
  patient       User               @relation(fields: [patientid], references: [id], onDelete: Cascade)
  specialtyslug String
  status        Bookingqueuestatus @default(WAITING)
  queuedat      DateTime           @default(now())
  matchedat     DateTime?
  doctorid      String?
  doctor        DoctorProfile?     @relation(fields: [doctorid], references: [id], onDelete: SetNull)
  bookingid     String?            @unique
  booking       Booking?           @relation(fields: [bookingid], references: [id], onDelete: SetNull)
  expiresat     DateTime
  concern       String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, specialtyslug, queuedat])
  @@index([patientid, status])
}

model Healthrecord {
  id         String           @id @default(cuid())
  userid     String
  user       User             @relation(fields: [userid], references: [id], onDelete: Cascade)
  name       String
  type       Healthrecordtype @default(OTHER)
  r2key      String
  filesize   Int
  mimetype   String
  sharedwith String[]
  uploadedat DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userid, uploadedat])
}

model ConsultationRoom {
  id              String     @id @default(cuid())
  bookingId       String     @unique
  booking         Booking    @relation(fields: [bookingId], references: [id])

  twilioRoomSid   String?    @unique
  twilioRoomName  String     @unique
  status          RoomStatus @default(WAITING)

  recordingSid    String?
  recordingUrl    String?
  recordingStatus String?

  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  chatLog         Json?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Prescription {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id])
  patientId     String
  doctorId      String

  diagnosis     String
  medicines     Json
  instructions  String?   @db.Text
  followUpDate  DateTime?

  pdfUrl        String?
  sentAt        DateTime?
  viewedAt      DateTime?
  aiDraft       Json?
  aiUsed        Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Soapnote {
  id            String    @id @default(cuid())
  bookingid     String    @unique
  booking       Booking   @relation(fields: [bookingid], references: [id], onDelete: Cascade)
  subjective    String    @db.Text
  objective     String    @db.Text
  assessment    String    @db.Text
  plan          String    @db.Text
  aidraftused   Boolean   @default(false)
  finalized     Boolean   @default(false)
  finalizedat   DateTime?
  patientshared Boolean   @default(false)
  sharedat      DateTime?
  sharedwithdoctorids String[] @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Familymember {
  id        String    @id @default(cuid())
  userid    String
  user      User      @relation(fields: [userid], references: [id], onDelete: Cascade)
  name      String
  relation  String
  dob       DateTime
  gender    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([userid])
}

model Devicetoken {
  id        String   @id @default(cuid())
  userid    String
  user      User     @relation(fields: [userid], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userid])
}

model Aicalllog {
  id           String   @id @default(cuid())
  doctoruserid String
  doctor       User     @relation(fields: [doctoruserid], references: [id], onDelete: Cascade)
  bookingid    String?
  endpoint     String
  inputsummary String   @db.VarChar(500)
  createdAt    DateTime @default(now())

  @@index([doctoruserid, createdAt])
}

model HealthNudge {
  id        String   @id @default(cuid())
  patientId String
  bookingId String?
  nudgeType String
  message   String   @db.Text
  sentAt    DateTime @default(now())
  opened    Boolean  @default(false)
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, nudgeType, sentAt])
}

model Labtestorder {
  id           String   @id @default(cuid())
  userid       String
  user         User     @relation(fields: [userid], references: [id], onDelete: Cascade)
  panelname    String
  testnames    String[]
  city         String
  address      String?  @db.Text
  phone        String?
  status       String   @default("REQUESTED")
  affiliateurl String?
  bookingid    String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userid, createdAt])
}

model Review {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  rating      Int
  comment     String?       @db.Text
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
}

model PlatformEarning {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id])
  platformFeeINR Int
  gstINR         Int
  totalEarned    Int
  tdsdeducted    Int      @default(0)
  tdsrate        Float    @default(0.10)
  netpayable     Int?
  month          Int
  year           Int
  createdAt      DateTime @default(now())
}

model BlogPost {
  id           String         @id @default(cuid())
  authorId     String
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  slug         String         @unique
  excerpt      String         @db.Text
  body         String         @db.Text
  category     String
  specialtySlug String?
  coverImage   String
  readingMinutes Int          @default(5)
  status       BlogPostStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, publishedAt])
}
